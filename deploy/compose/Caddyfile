# Automatic HTTPS for Vantage CRM on a single VPS.
#
# Caddy provisions and renews Let's Encrypt certificates on its own; there is
# nothing to run by hand. {$DOMAIN} is read from the environment (set in .env
# and passed by the compose overlay).
#
# Two names, both pointed at this VPS by an A-record:
#   {$DOMAIN}        the app (Next.js, which proxies to the API internally)
#   files.{$DOMAIN}  the S3/MinIO endpoint presigned upload/download URLs use
#
# Behind Cloudflare: trust CF's proxy ranges and read the real visitor IP from
# CF-Connecting-Ip, so audit logs and rate limits see the client, not a CF edge.
{
	servers {
		client_ip_headers Cf-Connecting-Ip
		trusted_proxies static \
			173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
			141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
			197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
			104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
			2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
			2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

files.{$DOMAIN} {
	encode zstd gzip
	# Preserve the Host header so MinIO's SigV4 signature check matches the
	# host the URL was signed for (S3_PUBLIC_ENDPOINT_URL=https://files.{$DOMAIN}).
	reverse_proxy minio:9000 {
		header_up Host {host}
	}
	# Uploads can be large; do not buffer the whole body.
	request_body {
		max_size 60MB
	}
}

n8n.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy n8n:5678
}
