# Production .env for the single-VPS Docker deploy.
#
# On the server: copy to the repo-root .env and fill in the values.
#   cp deploy/compose/.env.prod.example .env
# Generate every secret ON THE SERVER — never reuse a dev value, never paste a
# real secret into chat:
#   openssl rand -hex 32   # for JWT_SECRET
#   openssl rand -hex 24   # for each password below

# ------------------------------------------------------------------ core
ENVIRONMENT=production
# Your domain. Point DNS A-records for BOTH of these at the VPS IP:
#   crm.example.com  and  files.crm.example.com
DOMAIN=crm.example.com
WEB_ORIGIN=https://crm.example.com

# Sessions ride secure, host-scoped cookies in production.
COOKIE_SECURE=true
COOKIE_DOMAIN=crm.example.com
CORS_ORIGINS=["https://crm.example.com"]

# 32+ chars. openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32

# --------------------------------------------------------------- postgres
POSTGRES_DB=vantage
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=REPLACE_strong_password
# App + migrator roles (created by docker/postgres/init on first boot).
POSTGRES_PASSWORD=REPLACE_strong_password
POSTGRES_MIGRATION_USER=vantage_migrator
POSTGRES_MIGRATION_PASSWORD=REPLACE_strong_password

# ------------------------------------------------------------------ redis
REDIS_PASSWORD=REPLACE_strong_password

# ------------------------------------------------------------ file storage
# Local MinIO, fronted by Caddy at files.${DOMAIN}. Presigned URLs the browser
# follows are signed for this public endpoint.
S3_PUBLIC_ENDPOINT_URL=https://files.crm.example.com
S3_BUCKET=vantage-documents
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=REPLACE_strong_key
S3_SECRET_ACCESS_KEY=REPLACE_strong_secret
S3_SERVER_SIDE_ENCRYPTION=AES256

# --------------------------------------------------------------- AI (opt.)
# Claude — the most natural conversational model; the app gates spend with a
# budget ceiling. Leave blank to keep AI features off.
# ANTHROPIC_API_KEY=

# -------------------------------------------------------------- email (opt.)
# Transactional email (notifications, password reset). Deferable — in-app
# notifications work without it. Fill when a provider (e.g. Resend) is set up.
# EMAIL_* / SMTP_* keys go here per docs/HARDENING.md.
