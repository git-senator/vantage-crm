# Production .env for the single-VPS Docker deploy.
#
# On the server: copy to the repo-root .env and fill in the values.
#   cp deploy/compose/.env.prod.example .env
# Generate every secret ON THE SERVER — never reuse a dev value, never paste a
# real secret into chat:
#   openssl rand -hex 32   # for JWT_SECRET
#   openssl rand -hex 24   # for each password below

# ------------------------------------------------------------------ core
ENVIRONMENT=production
# Your domain. Point DNS A-records for BOTH of these at the VPS IP:
#   crm.example.com  and  files.crm.example.com
DOMAIN=crm.example.com
WEB_ORIGIN=https://crm.example.com

# Sessions ride secure, host-scoped cookies in production.
COOKIE_SECURE=true
COOKIE_DOMAIN=crm.example.com
CORS_ORIGINS=["https://crm.example.com"]

# 32+ chars. openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32

# ---------------------------------------------------------- encryption
# Encrypts secret columns (MFA/TOTP secrets) at rest. On a self-hosted VPS
# without AWS KMS, use an explicit local key — secrets are still sealed in the
# database. Generate the key ON THE SERVER (32 bytes, base64):
#   openssl rand -base64 32
# Then set it as `<id>:<base64>` and name that id as the active one.
ENCRYPTION_PROVIDER=local
ENCRYPTION_KEYS=main:REPLACE_WITH_openssl_rand_base64_32
ENCRYPTION_ACTIVE_KEY_ID=main

# --------------------------------------------------------------- postgres
POSTGRES_DB=vantage
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=REPLACE_strong_password
# App + migrator roles (created by docker/postgres/init on first boot).
POSTGRES_PASSWORD=REPLACE_strong_password
POSTGRES_MIGRATION_USER=vantage_migrator
POSTGRES_MIGRATION_PASSWORD=REPLACE_strong_password

# ------------------------------------------------------------------ redis
REDIS_PASSWORD=REPLACE_strong_password

# ------------------------------------------------------------ file storage
# Local MinIO, fronted by Caddy at files.${DOMAIN}. Presigned URLs the browser
# follows are signed for this public endpoint.
S3_PUBLIC_ENDPOINT_URL=https://files.crm.example.com
S3_BUCKET=vantage-documents
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=REPLACE_strong_key
S3_SECRET_ACCESS_KEY=REPLACE_strong_secret
S3_SERVER_SIDE_ENCRYPTION=AES256

# --------------------------------------------------------------- AI (opt.)
# One adapter (openai_compatible) speaks to Gemini / Groq / OpenRouter / OpenAI.
# The app gates spend with a monthly budget ceiling. Leave AI_ENABLED=false to
# keep AI features off. Example below is Google Gemini's free tier.
AI_PROVIDER=openai_compatible
AI_ENABLED=true
AI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-flash-latest
AI_REASONING_EFFORT=low
AI_MAX_OUTPUT_TOKENS=1500
AI_MONTHLY_COST_CEILING_USD=50
# Get a key at https://aistudio.google.com/apikey
AI_API_KEY=REPLACE_WITH_gemini_key

# -------------------------------------------------------------- email (SMTP)
# Transactional email (password reset, invitations). Any SMTP server works.
# For Gmail: host smtp.gmail.com, port 587, username the address, password a
# Google "App Password" (Account > Security > App passwords; needs 2FA on).
EMAIL_PROVIDER=smtp
EMAIL_FROM=REPLACE_with_your_gmail_address
EMAIL_FROM_NAME=Vantage CRM
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=REPLACE_with_your_gmail_address
SMTP_PASSWORD=REPLACE_with_gmail_app_password
