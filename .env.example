# Vantage CRM — environment template.
#
#   cp .env.example .env
#
# .env is gitignored. This template is tracked and must never contain a real
# secret. Production values come from the deployment environment, and before
# go-live from a managed secrets store (docs/SECURITY.md §6).

# ------------------------------------------------------------------- app
ENVIRONMENT=local
LOG_LEVEL=INFO
# Leave blank to follow ENVIRONMENT (readable locally, JSON everywhere else).
# Set true to force structured JSON logs locally.
LOG_JSON=

# -------------------------------------------------------------- postgres
POSTGRES_DB=vantage
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Superuser — used only by the postgres container at init.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dev_superuser_password

# Application role. NOT the table owner, no BYPASSRLS — this is what makes
# row-level security actually enforce anything. See docs/DATABASE.md §2.
POSTGRES_USER=vantage_app
POSTGRES_PASSWORD=dev_app_password

# Migration role. Owns the schema. Used only by Alembic.
POSTGRES_MIGRATION_USER=vantage_migrator
POSTGRES_MIGRATION_PASSWORD=dev_migrator_password

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# ----------------------------------------------------------------- redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=dev_redis_password

# ------------------------------------------------------------------ auth
# REQUIRED. Minimum 32 characters — the app refuses to start otherwise.
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32_minimum_thirty_two_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# false only for local http development; must be true anywhere else.
COOKIE_SECURE=false
COOKIE_DOMAIN=

PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# --------------------------------------------------------------- storage
# `memory` keeps uploads in the process and is for tests only — it is refused
# in production and loses every file on restart.
STORAGE_PROVIDER=s3

# MinIO locally. Leave S3_ENDPOINT_URL empty to target real AWS S3.
S3_ENDPOINT_URL=http://127.0.0.1:9000

# The endpoint the *browser* uses, when it differs from the one the API uses.
# In compose the API talks to `http://minio:9000`, which no browser resolves,
# and SigV4 signs the Host header — so a presigned URL has to be minted against
# the public name rather than rewritten afterwards. Leave empty for real S3.
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000

S3_REGION=us-east-1
S3_BUCKET=vantage-documents
S3_ACCESS_KEY_ID=vantage_dev_key
S3_SECRET_ACCESS_KEY=vantage_dev_secret

# Applied to every object and required on every presigned PUT. Blank only if
# the bucket already has default encryption configured.
S3_SERVER_SIDE_ENCRYPTION=AES256

# Presigned URLs are bearer credentials. Short by design.
S3_PRESIGN_TTL_SECONDS=300
S3_DOWNLOAD_TTL_SECONDS=120

# Enforced at finalization from the size storage reports, never from a
# client-declared number.
MAX_UPLOAD_BYTES=26214400
UPLOAD_WINDOW_SECONDS=3600

# When on, a verified upload stays unservable until the scan job clears it.
MALWARE_SCAN_ENABLED=false

# `eicar` detects the EICAR test file and nothing else — it proves the
# quarantine pipeline, it does not protect anything. Production refuses to
# start with scanning enabled while this is the configured engine.
MALWARE_SCANNER=eicar
MALWARE_SCAN_MAX_BYTES=16777216

# ---------------------------------------------------------------- workers
WORKER_MAX_JOBS=10
WORKER_JOB_TIMEOUT=300
WORKER_MAX_TRIES=5
WORKER_SWEEP_INTERVAL_MINUTES=15

# ------------------------------------------------------------- messaging
# Shared secret for the inbound-mail webhook's HMAC. Unset means inbound mail is
# refused outright — a default-open check on an unconfigured secret would accept
# anything that posted. Generate with: openssl rand -hex 32
INBOUND_WEBHOOK_SECRET=

# WhatsApp Business Cloud API (Meta). Unset means the channel refuses to send
# and inbound webhooks are refused — never a silent no-op.
WHATSAPP_API_BASE=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Echoed back during Meta's one-time webhook subscription handshake.
WHATSAPP_VERIFY_TOKEN=
# The app secret Meta signs webhook bodies with (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
# Which workspace inbound WhatsApp belongs to. Meta sends no tenant hint.
WHATSAPP_ORGANIZATION_ID=

# ------------------------------------------------------------------ mail
# Quote any value containing spaces: this file is both docker env_file and
# shell-sourceable, and an unquoted space breaks the latter.
# 'console' logs the message instead of sending — no AWS credentials needed
# locally, and a test run can never email a real person.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@vantagerealty.example
EMAIL_FROM_NAME="Vantage CRM"

# Used when EMAIL_PROVIDER=ses. Prefer an IAM instance role in production and
# leave these blank — static keys are the weaker option.
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_CONFIGURATION_SET=

# ------------------------------------------------------------------ cors
# Must stay empty in production: the browser never calls the API directly.
CORS_ORIGINS=[]

# -------------------------------------------------------------------- ai
# Off by default. The AI layer sends CRM data to an external model, so it is
# opt-in per deployment — a present key is not consent. `echo` never calls a
# model (safe for local/tests).
#
# Providers:
#   echo               - deterministic stub, no network (default)
#   anthropic          - Claude, via AI_API_BASE=https://api.anthropic.com
#   openai_compatible  - one adapter for Gemini / Groq / OpenRouter / Cerebras /
#                        OpenAI — anything speaking OpenAI Chat Completions.
#
# Example: Google Gemini on its free tier (its OpenAI-compatible endpoint).
# gemini-flash-latest is a reasoning model, so AI_REASONING_EFFORT bounds the
# hidden "thinking" to keep it from eating the visible answer's token budget.
AI_PROVIDER=echo
AI_ENABLED=false
AI_API_BASE=https://api.anthropic.com
AI_API_KEY=
AI_MODEL=claude-sonnet-5
# Only meaningful for reasoning models on openai_compatible: "" | none | low |
# medium | high. "low" is a good default for a chat assistant.
AI_REASONING_EFFORT=
AI_TIMEOUT_SECONDS=60
# Hard monthly spend ceiling per workspace, USD. Refused past it. 0 disables
# (production forbids a disabled ceiling).
AI_MONTHLY_COST_CEILING_USD=50
AI_MAX_OUTPUT_TOKENS=1024
#
# Gemini free-tier example (uncomment and set the key):
#   AI_PROVIDER=openai_compatible
#   AI_ENABLED=true
#   AI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-flash-latest
#   AI_REASONING_EFFORT=low
#   AI_MAX_OUTPUT_TOKENS=1500
#   AI_API_KEY=your-gemini-key

# ---------------------------------------------------------- off-site backups
# Cloudflare R2 destination for the nightly database dump. Read by
# deploy/backup/backup-local.sh and restore-from-r2.sh; leave blank and the
# backup still runs locally but warns that it is the only copy.
#
# The token should be an R2 API token scoped to this one bucket with
# "Object Read & Write" — not an account-wide or admin token — and restricted
# to the server's IP once the nightly upload is running.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
