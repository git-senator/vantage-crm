# Vantage CRM — environment template.
#
#   cp .env.example .env
#
# .env is gitignored. This template is tracked and must never contain a real
# secret. Production values come from the deployment environment, and before
# go-live from a managed secrets store (docs/SECURITY.md §6).

# ------------------------------------------------------------------- app
ENVIRONMENT=local
LOG_LEVEL=INFO
# Leave blank to follow ENVIRONMENT (readable locally, JSON everywhere else).
# Set true to force structured JSON logs locally.
LOG_JSON=

# -------------------------------------------------------------- postgres
POSTGRES_DB=vantage
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Superuser — used only by the postgres container at init.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dev_superuser_password

# Application role. NOT the table owner, no BYPASSRLS — this is what makes
# row-level security actually enforce anything. See docs/DATABASE.md §2.
POSTGRES_USER=vantage_app
POSTGRES_PASSWORD=dev_app_password

# Migration role. Owns the schema. Used only by Alembic.
POSTGRES_MIGRATION_USER=vantage_migrator
POSTGRES_MIGRATION_PASSWORD=dev_migrator_password

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# ----------------------------------------------------------------- redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=dev_redis_password

# ------------------------------------------------------------------ auth
# REQUIRED. Minimum 32 characters — the app refuses to start otherwise.
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32_minimum_thirty_two_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# false only for local http development; must be true anywhere else.
COOKIE_SECURE=false
COOKIE_DOMAIN=

PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# --------------------------------------------------------------- storage
# MinIO locally. Leave S3_ENDPOINT_URL empty to target real AWS S3.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vantage-documents
S3_ACCESS_KEY_ID=vantage_dev_key
S3_SECRET_ACCESS_KEY=vantage_dev_secret
S3_PRESIGN_TTL_SECONDS=300

# ------------------------------------------------------------------ mail
# Quote any value containing spaces: this file is both docker env_file and
# shell-sourceable, and an unquoted space breaks the latter.
# 'console' logs the message instead of sending — no AWS credentials needed
# locally, and a test run can never email a real person.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@vantagerealty.example
EMAIL_FROM_NAME="Vantage CRM"

# Used when EMAIL_PROVIDER=ses. Prefer an IAM instance role in production and
# leave these blank — static keys are the weaker option.
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_CONFIGURATION_SET=

# ------------------------------------------------------------------ cors
# Must stay empty in production: the browser never calls the API directly.
CORS_ORIGINS=[]
