# Шаблон настроек второго слушателя.
#
# На сервере копируется в `/opt/rognar-rossa/.env`, на машине разработчика —
# в `.env.rossa` в корне репозитория. Оба имени в .gitignore: реальные ключи
# в репозиторий не попадают никогда.
#
# Всё, что здесь перечислено, — СВОЁ, отдельное от первого Рогнара. Общий
# только ключ модели: судья один и тот же, платить за него дважды незачем.

# --- аккаунт-слушатель (номер сотрудника) -------------------------------
# api_id и api_hash берутся на https://my.telegram.org под ЭТИМ номером:
# «API development tools» → создать приложение (название любое).
ROGNAR_PHONE=+5511968422222
ROGNAR_API_ID=
ROGNAR_API_HASH=

# --- бот-почтальон -------------------------------------------------------
# Отдельный бот от @BotFather. Получатель обязан написать ему /start —
# без этого Telegram запрещает боту первым писать человеку.
ROGNAR_BOT_TOKEN=
# chat_id сотрудника, которому падают лиды (число, не @username).
ROGNAR_OWNER_CHAT_ID=

# --- что слушать ---------------------------------------------------------
# true  — все групповые чаты аккаунта (минус ignore.txt);
# false — только перечисленные в watchlist.txt.
ROGNAR_WATCH_JOINED=true

# --- модель-судья --------------------------------------------------------
AI_API_KEY=
AI_API_BASE=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
